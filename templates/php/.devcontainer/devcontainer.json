{
    "name": "PHP Environment",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "xdebug.php-debug",
                "bmewburn.vscode-intelephense-client"
            ]
        }
    },
    "forwardPorts": [8080],
    "postCreateCommand": "bash .devcontainer/scripts/post-create.sh",
    "remoteUser": "vscode"
}
